{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/schemas/*", "/*.{css,js,png,svg,ico,json,woff,woff2}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer"
  },
  "mimeTypes": { ".json": "application/ld+json" }
}
