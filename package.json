{
  "name": "cvl-vision-laboratory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8072 --strictPort",
    "start": "node scripts/server.mjs start",
    "stop": "node scripts/server.mjs stop",
    "build": "tsc --noEmit && vite build && node scripts/write-release.mjs && node scripts/verify-dist.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 8073 --strictPort",
    "test": "vitest run",
    "test:ui": "playwright test",
    "validate": "npm run lint && npm run build && npm test && npm run test:ui",
    "lint": "eslint .",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}